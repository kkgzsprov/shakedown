{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shakedown bug v1 strict wire",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reproduction": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "cwd"
      ],
      "additionalProperties": false
    },
    "expected": {
      "type": "string"
    },
    "actual": {
      "type": "string"
    },
    "suspected_cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "title",
    "reproduction",
    "expected",
    "actual",
    "suspected_cause",
    "evidence"
  ],
  "additionalProperties": false
}
